<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-6 offset-3">
        <div class="ctn"><h2>~ Sign Up ~</h2></div>
            
        <form action="/signup" method="post" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
            <input name="username" id="username" placeholder="Enter username" type="text" class="form-control" required>
            <div class="valid-feedback">-Cool Name-</div>
            </div>
            
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
            <input name="email" type="email" placeholder="Enter email address" class="form-control" required>
            <div class="invalid-feedback">Enter email first!!</div>
            </div>
            
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
            <input name="password" type="password" placeholder="Enter strong password" class="form-control" required>
            <div class="invalid-feedback">Enter a strong password!!</div>
            </div>        
            <br>
            <div class="ctn"> <button class="btn btn-dark add-btn">Sign up</button></div>
            
        </form>
    </div>
</div>
    

